{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "照片清冊產生器",
  "identifier": "tw.gov.tnpd.photo-report-generator",
  "version": "2.1.2",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File scripts/prepare-web.ps1"
  },
  "app": {
    "windows": [
      {
        "title": "照片清冊產生器",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
